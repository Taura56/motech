NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/motech-zone
PUBLIC_BACKEND_URL=https://your-public-backend.example
PUBLIC_FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-bytes
PAYMENT_ENCRYPTION_KEY=replace-with-a-32-byte-base64-encoded-key
SESSION_COOKIE_SECURE=false

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_ACCOUNT_REFERENCE=MOTECHZONE
DARAJA_TIMEOUT_MS=12000

MIKROTIK_ENABLED=false
MIKROTIK_HOST=192.168.10.1
MIKROTIK_PORT=8728
MIKROTIK_REST_PORT=443
MIKROTIK_USERNAME=motech-api
MIKROTIK_PASSWORD=
MIKROTIK_TLS_REJECT_UNAUTHORIZED=true
MIKROTIK_DEFAULT_PROFILE=default
MIKROTIK_CONNECT_TIMEOUT_MS=5000

RECONCILIATION_INTERVAL_MS=60000
LOG_LEVEL=info
