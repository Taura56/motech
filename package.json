{
  "name": "motech-zone",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "test": "npm run test --workspace backend",
    "build": "npm run build --workspace frontend",
    "admin:create": "npm run admin:create --workspace backend",
    "packages:seed": "npm run packages:seed --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
